# ===== Venus LLM 后端（必需，或用 LLM_CONFIG 切自建后端）=====
# 战略/战术层 LLM 后端凭据（MCP 直连 Venus，OpenAI Chat Completions 协议）。
# start-debug.sh 从 .env 读取并透传 --venus-api-key；缺失 MCP 启动会 fail。
VENUS_API_KEY=sk-xxx

# 可选覆盖（start-debug.sh 有默认值；如需自定义需自行在启动命令加对应 flag）：
# VENUS_URL=http://v2.open.venus.oa.com/llmproxy
# VENUS_MODEL=deepseek-v4.1-flash
# VENUS_STRATEGIC_MODEL=deepseek-v4-pro

# ===== LLM 后端配置文件（可选）=====
# 设置后走配置文件（可切换自建 SGLang / Venus），不再强制要求 VENUS_API_KEY。
# 例如指向自建 SGLang 的 Qwen2.5-7B-Instruct-GPTQ-Int4：
# LLM_CONFIG=assets/llm_backend.yaml

# ===== 网络端口（可选，start-debug.sh 读取）=====
# MCP Streamable HTTP 监听端口（debug 控制台 + 健康检查）。默认 8760。
# HTTP_PORT=8760
# WebSocket 监听端口（Mock UE 连接此端点推送感知）。默认 9090。
# WS_PORT=9090

# ===== 自动规划（可选，默认 true）=====
# true=战略/战术层自动决策；false=手动模式，仅响应 /debug/schedule 注入和
# /debug/action 手动下发，适合联调时隔离 UE 端。
AGENTTOWN_MCP_AUTO_PLAN=true

# ===== 持久化存储（可选，MySQL；Stage 3）=====
# 默认内存模式（NoopStore，无持久化，测试/quick-smoke 默认）。
# SKIP_MYSQL=1 时 start-debug.sh 跳过 MySQL 启动，MCP 降级内存模式。
# 数据库名（start-debug.sh 建库 + 拼默认 DSN 用；stable 默认 agenttown_stable，
# dev 实例在 start-dev.sh 中设为 agenttown_dev）。
# MYSQL_DB=agenttown_dev
# 完整 DSN（优先级高于 MYSQL_DB；main.go 在 flag 为空时回退读此 env）。
# DSN 必须含 parseTime=true 以正确扫描 DATETIME 列。
# MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/agenttown?parseTime=true&charset=utf8mb4
