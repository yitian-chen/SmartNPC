# ===== Venus LLM 后端 =====
# MCP 直连 Venus（OpenAI Chat Completions 协议），战略/战术层 LLM 后端。
# 凭据必需，缺失 MCP 启动会 fail。
VENUS_API_KEY=sk-xxx
# 可选覆盖（默认值见 agenttown-mcp flag）
# VENUS_URL=http://v2.open.venus.oa.com/llmproxy
# VENUS_MODEL=qwen3.6-35b-a3b

# ===== agenttown-mcp (host process, Go) =====
# MCP Streamable HTTP 监听地址（debug 控制台 + 健康检查）
AGENTTOWN_MCP_HTTP=:8760
# WebSocket 监听地址（Mock UE 连接此端点推送感知）
AGENTTOWN_MCP_WS=:9090

# ===== 反应层 LLM（可选，本地 Ollama）=====
# 默认值见 agenttown-mcp flag；禁用反应层留空 OLLAMA_URL
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
