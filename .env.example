# ══════════════ Venus LLM 后端（必需）══════════════
# 战略/战术层 LLM 后端凭据（MCP 直连 Venus，OpenAI Chat Completions 协议）。
# start 脚本从 .env 读取并透传 --venus-api-key；缺失 MCP 启动直接 fail。
# API key 获取：https://ai.woa.com/#/manager/api-account
VENUS_API_KEY=sk-xxx

# ══════════════ LLM 后端配置文件（可选，默认不设）══════════════
# 设置后走 assets/llm_backend.yaml 分层配置（战略/战术可分别指向不同
# 后端，如自建 vLLM/SGLang），替代上面的 Venus 直连。模板见
# assets/llm_backend.example.yaml，配置方法见 docs/Onboarding_Guide.md
# 「附：配置 LLM 后端切换」。
# LLM_CONFIG=assets/llm_backend.yaml

# ══════════════ 自动规划（可选，默认 true）══════════════
# true=战略/战术层自动决策；false=手动模式（仅响应 /debug/schedule 注入
# 和 /debug/action 手动下发），适合联调时隔离 UE 端单独验证 MCP 行为。
AGENTTOWN_MCP_AUTO_PLAN=true

# ══════════════ 端口（可选，一般无需配置）══════════════
# stable 实例默认 8760（HTTP）/ 9092（WS，UE5 连接此端点）；
# dev 实例由 start-dev.sh 设为 8770/9093。仅需要偏离脚本默认时再设。
# HTTP_PORT=8760
# WS_PORT=9092

# ══════════════ 持久化存储（可选，云环境默认启用）══════════════
# 云环境 start 脚本自动拉起 MySQL 并按实例选库（stable=agenttown_stable，
# dev=agenttown_dev），无需配置。
# SKIP_MYSQL=1                 # 跳过 MySQL，MCP 降级内存模式（无持久化）
# MYSQL_DSN=user:pass@tcp(127.0.0.1:3306)/agenttown?parseTime=true&charset=utf8mb4
#                               # 完整 DSN 覆盖脚本默认（须含 parseTime=true）
