# ===== LLM Provider =====
# 选择 Claude 或 OpenAI 兼容接口

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI 兼容接口（用 GPT / 本地模型时使用）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Hermes Agent 模型 =====
HERMES_AGENT_MODEL=claude-3.5-sonnet
# 如果用 OpenAI：
# HERMES_AGENT_MODEL=gpt-4o
# 如果用代理/中转：
# HERMES_AGENT_URL=https://your-proxy.com/v1

# ===== Hermes Gateway =====
# 一期单 NPC（H-01 老陈）
HERMES_PROFILE=H-01
HERMES_PORT=8642

# ===== Langfuse (可选，LLM 调用追踪) =====
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com

# ===== MCP Server (后续期，一期留空) =====
# SMARTNPC_MCP_URL=http://host.docker.internal:3000/mcp
