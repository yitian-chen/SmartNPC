# ===== LLM Provider =====
# 选择 Claude 或 OpenAI 兼容接口

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI 兼容接口（用 GPT / DeepSeek / 本地模型时使用）
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ===== Hermes Agent 配置（供 config.yaml 中 ${VAR} 展开）=====
# Hermes 在启动时从 .env 读取这些变量，替换 config.yaml 中的 ${HERMES_AGENT_*} 占位符
HERMES_AGENT_URL=https://api.deepseek.com
HERMES_AGENT_API_KEY=sk-xxx
HERMES_AGENT_MODEL=deepseek-v4-flash
# 如果用 Claude：
# HERMES_AGENT_URL=https://api.anthropic.com/v1
# HERMES_AGENT_MODEL=claude-3.5-sonnet

# ===== Hermes Gateway =====
# 一期单 NPC（H-01 老陈，Hermes profile 名需小写）
HERMES_PROFILE=h01
HERMES_PORT=8642

# ===== agenttown-mcp (host process, Go) =====
# MCP Streamable HTTP 监听地址（Hermes 连接此端点发现工具）
AGENTTOWN_MCP_HTTP=:8760
# WebSocket 监听地址（Mock UE 连接此端点推送感知）
AGENTTOWN_MCP_WS=:9090
# MCP 调用 Hermes Gateway 的地址
AGENTTOWN_MCP_HERMES_URL=http://localhost:8642
AGENTTOWN_MCP_HERMES_KEY=agenttown-test-key

# ===== Langfuse (可选，LLM 调用追踪) =====
# LANGFUSE_PUBLIC_KEY=pk-xxx
# LANGFUSE_SECRET_KEY=sk-xxx
# LANGFUSE_HOST=https://cloud.langfuse.com
